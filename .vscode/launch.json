{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train six visual agents (local Qwen, 200 rounds)",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/cxh/.conda/envs/b-magent-complete/bin/python",
            "module": "train.six_agent_training",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONNOUSERSITE": "1",
                "TOKENIZERS_PARALLELISM": "false"
            },
            "args": [
                "--mode", "b-magent",
                "--backend", "local-qwen",
                "--model-path", "${workspaceFolder}/models/Qwen2.5-VL-7B-Instruct",
                "--dataset-dir", "${workspaceFolder}/data/infographicsvqa",
                "--rounds", "200",
                "--output", "${workspaceFolder}/train/six_agent_training_report.json"
            ]
        },
        {
            "name": "Run qwen_gsm8k.py (quick placeholder)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/baseline/qwen_gsm8k.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--echo-placeholder",
                "--limit",
                "5",
                "--output",
                "baseline/qwen_gsm8k_report.json"
            ]
        },
        {
            "name": "Run qwen_gsm8k.py (local Qwen)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/baseline/qwen_gsm8k.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--model-path",
                "${workspaceFolder}/models/Qwen2.5-VL-3B-Instruct",
                "--output",
                "baseline/qwen_gsm8k_report.json"
            ]
        }
    ]
}
